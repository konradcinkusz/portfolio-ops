__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Editors and operating systems
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
